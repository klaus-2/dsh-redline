{
  "name": "dsh-redline",
  "version": "1.0.2",
  "type": "module",
  "main": "./lib/index.js",
  "description": "Point at any element on the page, adjust it live, and send structured visual feedback to your DeepSeek Harness agent.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "browser-annotation",
    "visual-review",
    "design-feedback",
    "ai-agents",
    "human-in-the-loop"
  ],
  "author": "klaus-2",
  "license": "MIT",
  "homepage": "https://github.com/klaus-2/dsh-redline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaus-2/dsh-redline.git"
  },
  "bugs": {
    "url": "https://github.com/klaus-2/dsh-redline/issues"
  },
  "files": [
    "lib",
    "locale",
    "docs/assets/icon.png",
    "vendor",
    "tencil-overlay.css",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "build": "node build-overlay.mjs",
    "test": "node tools/smoke.mjs",
    "strip-comments": "node tools/strip-comments.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "icon": "./docs/assets/icon.png"
}
