{
  "name": "dsh-redline",
  "version": "1.6.0",
  "type": "module",
  "main": "./lib/index.js",
  "description": "Visual feedback & design review for DeepSeek Harness: click any UI element in the browser, comment, tweak CSS live, and send structured context + screenshot to your agent.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness-plugin",
    "visual-feedback",
    "design-review",
    "ui-feedback",
    "annotation",
    "element-picker",
    "css-inspector",
    "screenshot",
    "frontend",
    "web-ui",
    "browser",
    "devtools",
    "ai-agent",
    "coding-agent",
    "vibe-coding",
    "design-to-code",
    "ux"
  ],
  "author": "klaus-2",
  "license": "MIT",
  "homepage": "https://github.com/klaus-2/dsh-redline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaus-2/dsh-redline.git"
  },
  "bugs": {
    "url": "https://github.com/klaus-2/dsh-redline/issues"
  },
  "files": [
    "lib",
    "locale",
    "docs/assets/icon.png",
    "vendor",
    "tencil-overlay.css",
    "THIRD-PARTY-NOTICES.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build-overlay.mjs",
    "test": "node tools/test.mjs && node tools/guest-injection-check.mjs",
    "smoke": "node tools/smoke.mjs",
    "regression": "node tools/regression.mjs",
    "strip-comments": "node tools/strip-comments.mjs",
    "syntax": "node --check lib/index.js && node --check lib/client.js && node --check lib/overlay.js && node --check lib/bridge.js && node --check overlay.template.js && node --check build-overlay.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "icon": "./docs/assets/icon.png"
}
